{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-load-draft",
    "allow-save-draft",
    "allow-load-settings",
    "allow-set-fallback",
    "allow-read-settings-form",
    "allow-list-headings",
    "allow-pick-vault-folder",
    "allow-save-settings",
    "allow-submit-entry",
    "allow-request-exit"
  ]
}
